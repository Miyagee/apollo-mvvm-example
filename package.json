{
  "name": "apollo-mvvm-example",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run codegen && next dev --turbopack",
    "build": "npm run codegen && next build",
    "start": "npm run codegen && next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "cypress open",
    "e2e:headless": "cypress run",
    "e2e:ci": "start-server-and-test dev http://localhost:3000 e2e:headless",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "graphql-codegen --config codegen.yml --watch",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apollo/client": "3.14.0",
    "@apollo/server": "5.0.0",
    "@as-integrations/next": "4.0.0",
    "graphql": "16.11.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/typescript": "5.0.0",
    "@graphql-codegen/typescript-operations": "5.0.0",
    "@graphql-codegen/typescript-react-apollo": "4.3.3",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "cypress": "15.3.0",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "prettier": "3.6.2",
    "start-server-and-test": "2.1.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
